   SENTINEL_REPO=~/Documents/sandbox/sentinel ./build_parity_drivers.sh \
       feature_parity regime_parity btc_cross_parity bar_parity
   image mjolnir-core-build:latest, sha 6b236c5, 4 drivers into build-linux/.

