# Build environment for libmjolnir_core (linux/amd64).
#
# Rocky 8 pins glibc 2.28 / gcc 8.5 — the oldest deploy target — so the produced
# .so also loads on newer-glibc hosts.
#
# TA-Lib is pinned to 0.6.4 because that is what PRODUCTION runs (verified on the
# live host). TA-Lib has changed indicator internals across releases, so a
# different version is a silent parity break rather than a rounding difference —
# do not float this to "latest".
FROM rockylinux/rockylinux:8

ARG TALIB_VERSION=0.6.4

# findutils: ta-lib's `make install` shells out to `find`, and without it the
# install step fails quietly enough to leave a half-installed tree behind.
RUN dnf -q install -y gcc-c++ cmake make wget tar gzip findutils && dnf clean all

RUN cd /tmp && \
    wget -q https://github.com/TA-Lib/ta-lib/releases/download/v${TALIB_VERSION}/ta-lib-${TALIB_VERSION}-src.tar.gz && \
    tar xzf ta-lib-${TALIB_VERSION}-src.tar.gz && \
    cd ta-lib-${TALIB_VERSION} && \
    ./configure --prefix=/usr/local --with-pic >/dev/null && \
    make -j"$(nproc)" >/dev/null && \
    make install >/dev/null && \
    echo /usr/local/lib > /etc/ld.so.conf.d/usrlocal.conf && ldconfig && \
    cd / && rm -rf /tmp/ta-lib-${TALIB_VERSION}*

# Fail the IMAGE build if the pinned version is not what landed, rather than
# discovering a parity break later from mismatched numbers. The version string
# is NOT in the headers, so ask the library itself — that is authoritative.
RUN test -f /usr/local/include/ta-lib/ta_libc.h || (echo "ta-lib headers missing" && exit 1)
RUN printf '#include <ta-lib/ta_libc.h>\n#include <stdio.h>\nint main(void){printf("%%s", TA_GetVersionString());return 0;}\n' > /tmp/tv.c && \
    gcc /tmp/tv.c -o /tmp/tv -L/usr/local/lib -lta-lib -lm && \
    VER="$(LD_LIBRARY_PATH=/usr/local/lib /tmp/tv)" && echo "ta-lib reports: $VER" && \
    case "$VER" in ${TALIB_VERSION}*) echo "TALIB VERSION OK" ;; \
      *) echo "FAIL: expected ${TALIB_VERSION}, got $VER" && exit 1 ;; esac && \
    rm -f /tmp/tv /tmp/tv.c

# LightGBM C API — the core loads model.txt via LGBM_BoosterCreateFromModelfile
# and predicts with LGBM_BoosterPredictForMat, i.e. the SAME inference kernel the
# Python wrapper calls, so predictions are identical rather than reimplemented.
ARG LIGHTGBM_VERSION=4.6.0
# Rocky 8 ships CMake 3.26.5 but LightGBM 4.6.0 requires >= 3.28. Install the
# official binary rather than dropping to an older LightGBM: the version must
# match production, for the same reason ta-lib does.
ARG CMAKE_VERSION=3.31.6
RUN cd /tmp && \
    wget -q https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz && \
    tar xzf cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz -C /opt && \
    ln -sf /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake /usr/local/bin/cmake && \
    rm -f cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz && \
    cmake --version | head -1
RUN dnf -q install -y git && \
    cd /tmp && git clone --depth 1 --branch v${LIGHTGBM_VERSION} --recursive \
        https://github.com/microsoft/LightGBM.git && \
    cd LightGBM && mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC_LIB=ON \
          -DCMAKE_POSITION_INDEPENDENT_CODE=ON .. >/dev/null && \
    make -j"$(nproc)" >/dev/null && make install >/dev/null && \
    ldconfig && cd / && rm -rf /tmp/LightGBM && dnf clean all
RUN test -f /usr/local/include/LightGBM/c_api.h || (echo "lightgbm headers missing" && exit 1)
# Static libs are what make libmjolnir_core.so SELF-CONTAINED. Without them the
# core carries runtime deps on /usr/local/lib, which exist in THIS image but not
# in the SDK build container or on the deploy host — so the strategy would fail
# to link, or link and then fail to load.
RUN test -f /usr/local/lib/lib_lightgbm.a || (echo "lib_lightgbm.a missing — static build did not produce it" && exit 1)
RUN test -f /usr/local/lib/libta-lib.a || (echo "libta-lib.a missing" && exit 1)
# Both .a files must be PIC or they cannot be linked into libmjolnir_core.so
# ("relocation R_X86_64_32 against .rodata can not be used when making a shared
# object"). Assert it here rather than discovering it at core-link time.
RUN readelf --relocs /usr/local/lib/lib_lightgbm.a 2>/dev/null | grep -q "R_X86_64_32[^S]" \
    && (echo "FAIL: lib_lightgbm.a is not PIC" && exit 1) || echo "lightgbm .a is PIC"
