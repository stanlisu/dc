build_dist/
__pycache__/
*.pyc
*.so
*.egg-info/
dist/
build/

# Vendored obfuscation codec copies — derived from obfuscation/ (single source
# of truth) by sync_vendor.py; regenerated by conftest.py and build_distribution.sh.
*_pkg/src/*/_obf/
obfuscation/inventory.err

# PyArmor crash dump (transient — e.g. the trial's "out of license"); it is
# regenerated on failure and carries local paths. deploy.log is the record we
# keep, not this.
pyarmor.bug.log
