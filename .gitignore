build_dist/
__pycache__/
*.pyc
*.so
*.egg-info/
dist/
build/

# Vendored obfuscation codec copies — derived from obfuscation/ (single source
# of truth) by sync_vendor.py; regenerated by conftest.py and build_distribution.sh.
*_pkg/src/*/_obf/
obfuscation/inventory.err

# PyArmor crash dump (transient — e.g. the trial's "out of license"); it is
# regenerated on failure and carries local paths. deploy.log is the record we
# keep, not this.
pyarmor.bug.log

# sentinel_core cross-build output (artifact, never source-controlled)
sentinel_core/build-linux/
agamotto_core/build-linux/
agamotto_core/build/
sentinel_core/build/

# Core dumps from running the linux/amd64 drivers under qemu on an arm64 host.
# Two land per crash: qemu dumps the emulated guest as qemu_<prog>_<stamp>.core,
# and the host may drop a plain `core` for qemu-x86_64 itself (~150MB the last
# time). Never commit either — a driver core is a memory image of the private
# core, which is the one thing this repo exists to keep out of anything
# shareable. Scoped to sentinel_core/ so a legitimately-named `core` module
# elsewhere in the tree is not swallowed.
sentinel_core/core
sentinel_core/*.core
